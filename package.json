{
  "name": "sparkbtcbot-skill",
  "version": "0.1.0",
  "description": "Spark Bitcoin L2 wallet skill for AI agents — encrypted-at-rest seed storage, Lightning interop, L402 paywall payment, BTKN/LRC20 tokens. Works with Claude Code (via plugin marketplace) and any other LLM agent framework (via the npm package's getSkillContent helpers).",
  "keywords": [
    "claude",
    "claude-code",
    "claude-skill",
    "claude-plugin",
    "ai-agent",
    "llm-agent",
    "agentic",
    "bitcoin",
    "spark",
    "spark-l2",
    "lightning",
    "lightning-network",
    "l402",
    "lsat",
    "wallet",
    "bip39",
    "btkn",
    "lrc20",
    "mcp",
    "btc"
  ],
  "homepage": "https://github.com/echennells/sparkbtcbot-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echennells/sparkbtcbot-skill.git"
  },
  "bugs": "https://github.com/echennells/sparkbtcbot-skill/issues",
  "license": "MIT",
  "author": "Eric Chennells",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node skills/sparkbtcbot/scripts/setup-encrypted-seed.js",
    "example:balance": "node skills/sparkbtcbot/scripts/balance-and-deposits.js",
    "example:payments": "node skills/sparkbtcbot/scripts/payment-flow.js",
    "example:tokens": "node skills/sparkbtcbot/scripts/token-operations.js",
    "example:agent": "node skills/sparkbtcbot/scripts/spark-agent.js",
    "example:l402": "node skills/sparkbtcbot/scripts/l402-paywalls.js",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --exclude tests/integration/funded",
    "test:funded": "vitest run tests/integration/funded",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@buildonspark/issuer-sdk": "^0.1.35",
    "@buildonspark/spark-sdk": "^0.7.17",
    "dotenv": "^16.4.7",
    "light-bolt11-decoder": "3.2.0",
    "vitest": "4.1.5"
  }
}
