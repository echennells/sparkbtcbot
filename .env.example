# Passphrase that decrypts the encrypted-seed file at boot.
# Run `npm run setup` once to create the encrypted seed; it lives at
# ~/.spark/seed.enc by default. The passphrase must be at least 12 chars.
# This file (and the env var) are USELESS WITHOUT the seed file —
# leaking .env alone does not drain the wallet.
SPARK_PASSPHRASE=

# Network: MAINNET, REGTEST, TESTNET, SIGNET
SPARK_NETWORK=MAINNET

# Optional: override the encrypted-seed file location
# SPARK_SEED_PATH=/path/to/seed.enc

# Optional: BIP32 account index
# Defaults to 1 for MAINNET, 0 for REGTEST
# Use different numbers for separate wallets from the same mnemonic
# NOTE: read from env only by the leaf-vault CLI (`npm run leaf-vault`);
# app code must pass accountNumber to SparkWallet.initialize itself.
# SPARK_ACCOUNT_NUMBER=1

# Optional: set to "off" to disable the automatic unilateral-exit backup
# (the "leaf-vault" recovery bundle SparkAgent maintains). On by default.
# SPARK_LEAF_VAULT=off

# Optional: override the recovery-bundle location.
# Use a distinct path per wallet/network if you run more than one on this machine.
# Default: ~/.spark/leaf-vault/current.json
# SPARK_LEAF_VAULT_PATH=/path/to/leaf-vault.json
